{
  "name": "qq-farm-bot",
  "version": "1.1502.16",
  "appVersion": "1.15.02.016",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "files": [
    "client.js",
    "src",
    "qq-login/*.mjs",
    "qq-login/*.cjs",
    "qq-login/licenses",
    "share.txt"
  ],
  "main": "client.js",
  "bin": "client.js",
  "scripts": {
    "start": "node client.js",
    "dev": "node client.js",
    "build:release": "node ../scripts/package-platform.cjs win32-x64 && node ../scripts/package-platform.cjs linux-docker",
    "build:win": "node ../scripts/package-platform.cjs win32-x64",
    "build:linux": "node ../scripts/package-platform.cjs linux-docker",
    "build:mac": "pkg . --no-bytecode --targets node18-macos-x64,node18-macos-arm64 --out-path dist",
    "lint": "eslint . --fix",
    "test": "node --require ./test/setup.cjs --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.21.0",
    "https-proxy-agent": "^7.0.6",
    "long": "^5.3.2",
    "multer": "^2.2.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.7",
    "protobufjs": "^8.0.0",
    "pushoo": "^0.1.11",
    "socket.io": "^4.8.3",
    "socks-proxy-agent": "^8.0.5",
    "winston": "^3.18.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "../web/dist/**/*",
      "src/gameConfig/**/*",
      "src/proto/**/*",
      "src/modern/**/*",
      "src/utils/*.wasm",
      "src/__bolt_manifest.json",
      "share.txt"
    ]
  }
}
